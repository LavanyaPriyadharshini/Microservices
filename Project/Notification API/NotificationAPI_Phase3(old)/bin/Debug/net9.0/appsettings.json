{
  // ════════════════════════════════════════════════════════════════════════
  // LOGGING CONFIGURATION
  // ════════════════════════════════════════════════════════════════════════
  "Logging": {
    "LogLevel": {
      // Default log level for all categories
      "Default": "Information",
      // Reduce ASP.NET Core internal logging noise
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ════════════════════════════════════════════════════════════════════════
  // ALLOWED HOSTS - Security setting for HTTP Host header
  // ════════════════════════════════════════════════════════════════════════
  "AllowedHosts": "*",

  // ════════════════════════════════════════════════════════════════════════
  // KAFKA CONFIGURATION - Message broker connection settings
  // ════════════════════════════════════════════════════════════════════════
  "Kafka": {
    // BootstrapServers = Address of Kafka broker
    //
    // LOCAL DEVELOPMENT (running outside Docker):
    // - Use "localhost:9092"
    // - Connects to Kafka running in Docker via port forwarding
    //
    // DOCKER ENVIRONMENT:
    // - Docker Compose overrides this with "kafka:29092"
    // - Uses internal Docker network (faster, no port forwarding)
    //
    // Why two different ports?
    // - 9092: External access (host machine → Docker)
    // - 29092: Internal access (container → container)
    //
    // IMPORTANT: This value is overridden in docker-compose.yml
    // See: environment section of notification-api service
    "BootstrapServers": "localhost:9092"
  }

  // ════════════════════════════════════════════════════════════════════════
  // RABBITMQ CONFIGURATION (COMMENTED - Enable when implementing)
  // ════════════════════════════════════════════════════════════════════════
  // Uncomment below section when implementing RabbitMQ consumer
  //
  // "RabbitMQ": {
  //   "Host": "localhost",           // RabbitMQ server address
  //   "Port": 5672,                  // AMQP protocol port
  //   "Username": "guest",           // Authentication username
  //   "Password": "guest",           // Authentication password
  //   "QueueName": "order.created.queue",  // Queue to consume from
  //   "ExchangeName": "order.exchange",    // Exchange name
  //   "RoutingKey": "order.created"        // Routing key
  // }

  // ════════════════════════════════════════════════════════════════════════
  // EMAIL CONFIGURATION (For future email notifications)
  // ════════════════════════════════════════════════════════════════════════
  // Add this section when implementing email notifications
  //
  // "Email": {
  //   "SmtpServer": "smtp.gmail.com",
  //   "SmtpPort": 587,
  //   "SmtpUsername": "your-email@gmail.com",
  //   "SmtpPassword": "your-app-specific-password",
  //   "FromEmail": "noreply@yourdomain.com",
  //   "FromName": "E-Commerce Notifications",
  //   "EnableSsl": true
  // }

  // ════════════════════════════════════════════════════════════════════════
  // SMS CONFIGURATION (For future SMS notifications via Twilio)
  // ════════════════════════════════════════════════════════════════════════
  // Add this section when implementing SMS notifications
  //
  // "Twilio": {
  //   "AccountSid": "your-account-sid",
  //   "AuthToken": "your-auth-token",
  //   "FromPhoneNumber": "+1234567890"
  // }
}
