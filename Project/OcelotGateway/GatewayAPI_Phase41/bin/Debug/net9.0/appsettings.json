{
  // ════════════════════════════════════════════════════════════════════════
  // LOGGING CONFIGURATION
  // ════════════════════════════════════════════════════════════════════════
  "Logging": {
    "LogLevel": {
      // Default log level for all categories
      "Default": "Information",
      // Reduce noise from ASP.NET Core internals
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ════════════════════════════════════════════════════════════════════════
  // ALLOWED HOSTS - Security setting for HTTP Host header
  // ════════════════════════════════════════════════════════════════════════
  "AllowedHosts": "*"

  // ════════════════════════════════════════════════════════════════════════
  // IMPORTANT NOTE ABOUT OCELOT CONFIGURATION
  // ════════════════════════════════════════════════════════════════════════
  // Ocelot routing configuration is NOT in this file!
  // It's in: ocelot.Docker.json
  //
  // Why separate file?
  // - Keeps routing configuration clean and focused
  // - appsettings.json = Application settings (logging, hosts, etc.)
  // - ocelot.Docker.json = Routing rules (upstream/downstream paths)
  //
  // This approach follows separation of concerns:
  // - appsettings.json: How the app behaves
  // - ocelot.Docker.json: Where requests are routed
  //
  // ════════════════════════════════════════════════════════════════════════


  // ════════════════════════════════════════════════════════════════════════
  // FUTURE CONFIGURATIONS (Add when needed)
  // ════════════════════════════════════════════════════════════════════════

  // JWT AUTHENTICATION (Add when implementing auth at gateway level):
  // "JwtSettings": {
  //   "SecretKey": "your-super-secret-key-min-32-chars",
  //   "Issuer": "https://your-auth-server.com",
  //   "Audience": "https://your-api.com",
  //   "ExpirationMinutes": 60
  // }

  // RATE LIMITING (Add when implementing rate limiting):
  // "RateLimiting": {
  //   "EnableEndpointRateLimiting": true,
  //   "StackBlockedRequests": false,
  //   "HttpStatusCode": 429,
  //   "GeneralRules": [
  //     {
  //       "Endpoint": "*",
  //       "Period": "1m",
  //       "Limit": 100
  //     }
  //   ]
  // }

  // CORS SETTINGS (If more complex than AllowAll):
  // "Cors": {
  //   "AllowedOrigins": ["http://localhost:3000", "https://yourdomain.com"],
  //   "AllowedMethods": ["GET", "POST", "PUT", "DELETE"],
  //   "AllowedHeaders": ["Content-Type", "Authorization"]
  // }

  // ════════════════════════════════════════════════════════════════════════
}
