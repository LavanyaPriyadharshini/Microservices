<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!-- PROJECT CONFIGURATION                                                -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <!-- Target Framework: .NET 9.0 (latest LTS version) -->
    <TargetFramework>net9.0</TargetFramework>

    <!-- Enable nullable reference types for better null safety -->
    <Nullable>enable</Nullable>

    <!-- Enable implicit usings (System, System.Collections.Generic, etc.) -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!-- NUGET PACKAGES                                                       -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- OCELOT API GATEWAY - The main package for routing                -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- What is Ocelot?                                                   -->
    <!-- - API Gateway that sits in front of all microservices            -->
    <!-- - Routes incoming requests to correct downstream service         -->
    <!-- - Single entry point for clients (mobile apps, web apps)         -->
    <!--                                                                   -->
    <!-- Why use Ocelot?                                                   -->
    <!-- - Clients call ONE URL instead of tracking multiple service URLs -->
    <!-- - Centralized authentication, rate limiting, caching             -->
    <!-- - Load balancing across multiple service instances               -->
    <!-- - Request/Response transformation                                -->
    <!--                                                                   -->
    <!-- Example Flow:                                                     -->
    <!-- Client calls: http://gateway:8080/api/products                   -->
    <!--     ↓                                                             -->
    <!-- Ocelot routes to: http://product-api:8080/api/product/getall     -->
    <!--     ↓                                                             -->
    <!-- Product API responds                                              -->
    <!--     ↓                                                             -->
    <!-- Ocelot returns response to client                                -->
    <PackageReference Include="Ocelot" Version="23.0.0" />

    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- ASP.NET CORE PACKAGES (Optional - for Swagger documentation)     -->
    <!-- ──────────────────────────────────────────────────────────────── -->
    <!-- Uncomment if you want Swagger UI on gateway to see all routes:   -->
    <!-- <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.3" /> -->
    <!-- <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" /> -->
  </ItemGroup>

